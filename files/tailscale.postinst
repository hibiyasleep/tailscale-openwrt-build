#!/bin/sh
# OpenWRT's auto-generated default postinst: source functions.sh and call
# default_postinst, which enables + starts the /etc/init.d/tailscale service
# (found in the installed filelist). The `tailscale` CLI symlink ships in the
# data tree, so it needs no handling here.
[ "${IPKG_NO_SCRIPT}" = "1" ] && exit 0
[ -s "${IPKG_INSTROOT}/lib/functions.sh" ] || exit 0
. "${IPKG_INSTROOT}/lib/functions.sh"
default_postinst "$0" "$@"
